<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CalculadoraIMCyCientifica" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.CalculadoraIMCyCientifica" parent="Base.Theme.CalculadoraIMCyCientifica" />

    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/selector_borde_caja</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="ResultadoEtiqueta" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="ResultadoValor" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>