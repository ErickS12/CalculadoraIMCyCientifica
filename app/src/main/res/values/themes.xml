<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CalculadoraIMCyCientifica" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.CalculadoraIMCyCientifica" parent="Base.Theme.CalculadoraIMCyCientifica" />

    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/selector_borde_caja</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="ResultadoEtiqueta" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="ResultadoValor" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textStyle">bold</item>
    </style>


<!--    Calculadora cientifica: -->

    <style name="Tecla" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/borde</item>
    </style>

    <style name="Tecla.Funcion">
        <item name="backgroundTint">@color/tecla_funcion_fondo</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Tecla.Numero">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Tecla.Operador">
        <item name="backgroundTint">@color/verde_suave</item>
        <item name="android:textColor">@color/verde_pino</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Tecla.ModoActivo">
        <item name="backgroundTint">@color/verde_suave</item>
        <item name="android:textColor">@color/verde_pino</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Tecla.Igual">
        <item name="backgroundTint">@color/verde_pino</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>